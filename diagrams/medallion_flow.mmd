graph LR
    subgraph input["📥 Ingestão\nbronze/automatizado/"]
        uc_a["use_case_a/\nCSV + GeoJSON"]
        uc_b["use_case_b/\nCSV + GeoJSON"]
        processed["processados/\n(movido após silver salvo)"]
    end

    subgraph airflow["⚙️ Airflow\nesteira_geo_watcher → esteira_geo"]
        sensor["detecta_e_dispara\na cada 30s\nignora use_cases já ativos"]
        branch["branch_gold\nverifica silver acumulado total\nnão apenas o lote atual"]
        sensor --> branch
    end

    subgraph silver_layer["⚪ SILVER\nS3: silver/use_case/"]
        s_areas["silver_flooding_areas.parquet\nAcumulativo por area_id\n_safe_concat (schema-tolerante)"]
        s_citizens["silver_citizens_data.parquet\nAcumulativo por citizen_id\n_safe_concat (schema-tolerante)"]
        s_checks["Normalização:\n✓ Geometrias válidas\n✓ citizen_id → str\n✓ registration_date\n✓ Dedup por ID\n✓ WKT + datetime str antes concat"]
    end

    subgraph gold_layer["🟡 GOLD\nS3: gold/use_case/\nFonte exclusiva do PostGIS"]
        g_areas_only["flooding_areas.parquet\n(process_gold_areas_only)\ngerado mesmo sem cidadãos"]
        g_join["🎯 Spatial Join\ngeopandas sjoin within"]
        g_affected["affected_citizens.parquet"]
        g_unaffected["unaffected_citizens.parquet"]
        g_all["all_citizens_evaluated.parquet"]
    end

    subgraph postgis["🗺️ PostGIS\nesteira_geo"]
        pg_areas["use_case_flooding_areas\nGEOMETRY POLYGON 4326\nGIST index"]
        pg_citizens["use_case_citizens\nGEOMETRY POINT 4326\naffected_by_flooding\nGIST index"]
        pg_note["Fonte: GOLD\nTRUNCATE + INSERT\na cada pipeline"]
    end

    subgraph flask["🌐 Flask :5000"]
        api_stats["/api/stats?use_case=\nfallback automático\npara use_case disponível"]
        api_geojson["/api/geojson?use_case="]
        api_uc["/api/use_cases"]
        map_leaflet["/map\nLeaflet + SVG markers\nfitBounds em áreas\nquando sem cidadãos"]
    end

    input --> airflow

    airflow -->|"Task: silver"| s_checks
    s_checks --> s_areas
    s_checks --> s_citizens

    s_areas -->|"só áreas\nprocess_gold_areas_only"| g_areas_only
    s_areas --> g_join
    s_citizens --> g_join
    g_join --> g_affected
    g_join --> g_unaffected
    g_join --> g_all

    g_areas_only --> pg_areas
    g_affected --> pg_citizens
    g_unaffected --> pg_citizens
    g_all -.->|"all_citizens\n(referência)"| pg_citizens

    pg_note --- pg_areas
    pg_note --- pg_citizens

    pg_citizens --> api_stats
    pg_citizens --> api_geojson
    pg_areas --> api_geojson
    api_stats --> map_leaflet
    api_geojson --> map_leaflet
    api_uc --> map_leaflet

    uc_a -->|"após silver salvo"| processed
    uc_b -->|"após silver salvo"| processed

    style input fill:#4E342E,stroke:#000,color:#fff
    style airflow fill:#017CEE,stroke:#000,color:#fff
    style silver_layer fill:#616161,stroke:#000,color:#fff
    style gold_layer fill:#F9A825,stroke:#000,color:#000
    style postgis fill:#336791,stroke:#000,color:#fff
    style flask fill:#013243,stroke:#000,color:#fff
