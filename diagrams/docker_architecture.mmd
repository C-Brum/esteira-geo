graph TB
    subgraph host["🖥️ Host Machine\nLinux/macOS/Windows"]
        data_dir["📁 data/bronze/automatizado/\nuse_case_a/ use_case_b/"]
        notebooks_dir["📓 notebooks/\nesteira_geo.ipynb\nutilitarios.ipynb"]
        dags_dir["📁 airflow/dags/\nesteira_geo_dag.py\nesteira_geo_watcher_dag.py\nesteira_geo_manutencao_dag.py"]
        pipeline_dir["📁 pipeline/\netl/ + config.py\nweb/app.py + templates/"]
    end

    subgraph docker_network["🌐 Docker Network: esteira-network"]

        subgraph postgis_service["PostgreSQL + PostGIS"]
            db["🗄️ PostgreSQL 13\nDatabase: esteira_geo\nPort: 5432\npipeline + Airflow metadata"]
        end

        subgraph minio_service["MinIO (S3 Compatible)"]
            subgraph buckets["Buckets"]
                b_bronze["bronze/automatizado/\n  use_case/\n  use_case/processados/"]
                b_silver["silver/use_case/\nsilver_citizens.parquet\nsilver_flooding.parquet"]
                b_gold["gold/use_case/\nflooding_areas.parquet\naffected_citizens.parquet\nunaffected_citizens.parquet\nall_citizens_evaluated.parquet"]
            end
        end

        subgraph airflow_services["Apache Airflow"]
            af_init["🔧 airflow-init\ndb migrate + user"]
            af_webserver["🖥️ Webserver :8080\nadmin/admin"]

            subgraph scheduler["⚙️ Scheduler (LocalExecutor)"]
                subgraph watcher_dag["DAG: esteira_geo_watcher (30s)"]
                    w_detect["detecta_e_dispara\nLista bronze/automatizado/\nDispara esteira_geo\npor use_case"]
                end
                subgraph main_dag["DAG: esteira_geo (trigger)"]
                    t_silver["silver\nprocess_silver()\n_safe_concat"]
                    t_branch["branch_gold\nverifica silver acumulado"]
                    t_gold["gold\nprocess_gold()"]
                    t_postgis["postgis\nload_to_postgis()"]
                    t_areas["postgis_areas_only\nprocess_gold_areas_only()\n+ load_to_postgis()"]
                    t_skip["skip_gold"]
                end
                subgraph manut_dag["DAG: esteira_geo_manutencao (diário)"]
                    t_clean["limpar_historico_30_dias\nairflow db clean"]
                end
            end

            t_silver --> t_branch
            t_branch --> t_gold --> t_postgis
            t_branch --> t_areas
            t_branch --> t_skip
            w_detect -->|"trigger conf={use_case}"| main_dag
        end

        subgraph pipeline_service["Pipeline ETL (idle)"]
            p_idle["testes manuais\nmain.py\nbronze_loader.py"]
        end

        subgraph web_service["Flask Web :5000"]
            flask["Dashboard + Leaflet\n/api/stats\n/api/geojson\n/api/use_cases\n/map (SVG markers)"]
        end

        subgraph jupyter_service["JupyterLab :8888"]
            jupyter["token: esteira\nesteira_geo.ipynb\nutilitarios.ipynb"]
        end

    end

    data_dir -->|bind mount| b_bronze
    notebooks_dir -->|bind mount| jupyter_service
    dags_dir -->|volume| scheduler
    pipeline_dir -->|volume etl+config+web| scheduler
    pipeline_dir -->|volume web| web_service

    af_init -->|db migrate| db
    t_silver -->|lê| b_bronze
    t_silver -->|salva acumulativo| b_silver
    t_gold -->|lê| b_silver
    t_gold -->|salva| b_gold
    t_areas -->|lê silver + salva| b_gold
    t_postgis -->|lê gold| b_gold
    t_postgis -->|TRUNCATE+INSERT| db
    t_areas -->|TRUNCATE+INSERT áreas| db

    flask -->|queries| db
    jupyter -->|boto3| minio_service
    jupyter -->|psycopg2| db

    style host fill:#2196F3,stroke:#000,color:#fff
    style docker_network fill:#1b5e20,stroke:#000,color:#fff
    style postgis_service fill:#336791,stroke:#000,color:#fff
    style minio_service fill:#C41E3A,stroke:#000,color:#fff
    style airflow_services fill:#017CEE,stroke:#000,color:#fff
    style scheduler fill:#0052cc,stroke:#000,color:#fff
    style watcher_dag fill:#003d99,stroke:#000,color:#fff
    style main_dag fill:#003d99,stroke:#000,color:#fff
    style manut_dag fill:#003d99,stroke:#000,color:#fff
    style pipeline_service fill:#F37021,stroke:#000,color:#fff
    style web_service fill:#013243,stroke:#000,color:#fff
    style jupyter_service fill:#F57F17,stroke:#000,color:#fff
    style buckets fill:#b71c1c,stroke:#000,color:#fff
