FROM python:3.11-slim

USER root

# Java (necessário para Spark) + dependências geoespaciais
RUN apt-get update && apt-get install -y \
    default-jdk-headless \
    gdal-bin libgdal-dev libgeos-dev libproj-dev \
    curl procps \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/default-java
ENV SPARK_HOME=/opt/spark
ENV PATH=$SPARK_HOME/bin:$PATH
ENV PYTHONPATH=$SPARK_HOME/python:$SPARK_HOME/python/lib/py4j-0.10.9.7-src.zip:$PYTHONPATH

# Instalar Spark 3.5.0
RUN curl -fsSL https://archive.apache.org/dist/spark/spark-3.5.0/spark-3.5.0-bin-hadoop3.tgz \
    | tar -xz -C /opt && mv /opt/spark-3.5.0-bin-hadoop3 /opt/spark

# JARs: Sedona, GeoTools, PostgreSQL JDBC, S3A
RUN curl -fsSL -o $SPARK_HOME/jars/sedona-spark-shaded-3.5_2.12-1.6.0.jar \
    https://repo1.maven.org/maven2/org/apache/sedona/sedona-spark-shaded-3.5_2.12/1.6.0/sedona-spark-shaded-3.5_2.12-1.6.0.jar && \
    curl -fsSL -o $SPARK_HOME/jars/geotools-wrapper-1.6.0-28.2.jar \
    https://repo1.maven.org/maven2/org/datasyslab/geotools-wrapper/1.6.0-28.2/geotools-wrapper-1.6.0-28.2.jar && \
    curl -fsSL -o $SPARK_HOME/jars/postgresql-42.7.3.jar \
    https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.3/postgresql-42.7.3.jar && \
    curl -fsSL -o $SPARK_HOME/jars/hadoop-aws-3.3.4.jar \
    https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar && \
    curl -fsSL -o $SPARK_HOME/jars/aws-java-sdk-bundle-1.12.262.jar \
    https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar

# Python: geoespacial + Sedona + PySpark
RUN pip install --no-cache-dir \
    pyspark==3.5.0 \
    apache-sedona==1.6.0 \
    geopandas==0.14.4 \
    pyarrow==15.0.2 \
    psycopg2-binary==2.9.9 \
    boto3==1.34.69 \
    python-dotenv==1.0.1 \
    shapely==2.0.4

WORKDIR /app

COPY pipeline/*.py ./
COPY pipeline/etl ./etl
COPY pipeline/watchers ./watchers
COPY pipeline/entrypoint.sh ./
RUN chmod +x /app/entrypoint.sh

RUN mkdir -p /data/bronze /data/silver /data/gold /app/logs /app/data

VOLUME ["/data/bronze", "/data/silver", "/data/gold"]

ENTRYPOINT ["/app/entrypoint.sh"]
